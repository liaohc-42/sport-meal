# ===== 服务 =====
PORT=3001
NODE_ENV=development

# 允许访问 API 的前端来源（逗号分隔）
# 本地开发：http://localhost:3001,http://127.0.0.1:5500
# GitHub Pages：https://<你的用户名>.github.io
FRONTEND_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:5500,http://localhost:5500

# ===== DeepSeek（可选）=====
# 不配置时，后端自动使用本地教练与本地话术，不会影响计划生成。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=25000

# ===== 营养联网检索 =====
# 默认开启：优先请求 Open Food Facts，再回退到本地营养库 / 常识估算
NUTRITION_ONLINE=true
NUTRITION_TIMEOUT_MS=5000

# ===== 菜单图片 OCR =====
# 免费申请：https://ocr.space/ocrapi
# 不填写时使用公开演示 key "helloworld"（限流，仅适合本地体验）
# auto: 先 OCR.space，失败自动回退本地 Tesseract.js
# ocrspace: 只用云端；tesseract: 只用本地（首次会下载中文语言包）
OCR_PROVIDER=auto
OCR_SPACE_API_KEY=
OCR_SPACE_LANGUAGE=chs
OCR_TIMEOUT_MS=20000
TESSERACT_LANGS=chi_sim+eng

# ===== 数据库 =====
# 本地默认 backend/data/app.db；Vercel 请设为 /tmp/app.db
DB_PATH=
